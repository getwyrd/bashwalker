%% C4 level 1: the system and who or what it talks to (architecture §3).
%% Replace the placeholder people and systems with the real ones.
C4Context
  title System context for bashwalker

  Person(user, "User", "Who uses the system and why")
  System(system, "bashwalker", "A bash command line in, proven facts per simple command out: a fail-closed tree-sitter-bash walker (extracted from nl-shell)")
  System_Ext(external, "External system", "Something the system depends on or serves")

  Rel(user, system, "Uses")
  Rel(system, external, "Calls / reads / writes")
